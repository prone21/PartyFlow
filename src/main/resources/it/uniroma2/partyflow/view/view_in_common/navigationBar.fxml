<?import javafx.scene.text.Font?>

<HBox prefHeight="0.0" prefWidth="800.0" style="-fx-border-color: #153a5f; -fx-border-width: 3; -fx-background-color: #153a5f;" BorderPane.alignment="CENTER" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.uniroma2.partyflow.graphic_controllers.gui.graphic_controllers_in_common.NavigationBarGraphicControllerGUI">
    <children>
        <Button mnemonicParsing="false" onMouseClicked="#goHomePage" prefHeight="106.0" prefWidth="276.0" style="-fx-font-weight: bold; -fx-border-color: #F6F7F9; -fx-border-width: 0 3 0 0; -fx-background-color: transparent; -fx-font-size: 25;" text="Home" textFill="#f6f7f9">
            <font>
                <Font size="25.0" />
            </font>
        </Button>
        <Button mnemonicParsing="false" onMouseClicked="#myNotifications" prefHeight="104.0" prefWidth="265.0" style="-fx-font-weight: bold; -fx-background-color: transparent; -fx-border-color: #F6F7F9; -fx-border-width: 0 3 0 0; -fx-font-size: 25;" text="My notifications" textAlignment="CENTER" textFill="#f6f7f9" wrapText="true">
