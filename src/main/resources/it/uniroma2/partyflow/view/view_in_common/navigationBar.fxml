                <Font size="25.0" />
            </font>
        </Button>
        <Button mnemonicParsing="false" onMouseClicked="#goProfile" prefHeight="104.0" prefWidth="284.0" style="-fx-font-weight: bold; -fx-background-color: transparent; -fx-border-color: #F6F7F9; -fx-border-width: 0 0 0 0; -fx-font-size: 25;" text="Profile" textFill="#f6f7f9">
