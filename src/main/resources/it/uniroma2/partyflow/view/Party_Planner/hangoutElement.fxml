<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<!-- Singolo elemento dell'elenco My Hangouts. Da inserire nella VBox dello ScrollPane. -->

<HBox alignment="CENTER_LEFT" minHeight="145.0" prefHeight="145.0" prefWidth="600.0" spacing="0.0" style="-fx-background-color: #F6F7F9; -fx-background-radius: 12; -fx-border-color: rgba(21,58,95,0.25); -fx-border-radius: 12; -fx-border-width: 1.5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <AnchorPane minHeight="145.0" prefHeight="145.0" prefWidth="600.0" style="-fx-background-color: transparent;">
         <children>
            <Label fx:id="hangoutNameLabel" layoutX="26.0" layoutY="48.0" prefHeight="49.0" prefWidth="290.0" style="-fx-font-weight: bold;" text="&lt;Hangout name&gt;" textFill="#153A5F">
               <font><Font size="30.0" /></font>
            </Label>
            <Button fx:id="planButton" layoutX="337.0" layoutY="46.0" mnemonicParsing="false" prefHeight="48.0" prefWidth="105.0" style="-fx-background-color: #2978DE; -fx-background-radius: 15; -fx-border-width: 0; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Plan" textFill="#F6F7F9">
               <font>
                  <Font size="20.0" />
               </font></Button>
            <Button fx:id="detailsButton" layoutX="465.0" layoutY="20.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="112.0" style="-fx-background-color: #2978DE; -fx-background-radius: 15; -fx-border-width: 0; -fx-font-size: 20px; -fx-font-weight: bold; -fx-cursor: hand;" text="Details" textFill="#F6F7F9" />
            <Button fx:id="manageButton" layoutX="465.0" layoutY="79.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="112.0" style="-fx-background-color: #2978DE; -fx-background-radius: 15; -fx-border-width: 0; -fx-font-size: 20px; -fx-font-weight: bold; -fx-cursor: hand;" text="Manage" textFill="#F6F7F9" />
         </children>
      </AnchorPane>
   </children>
</HBox>
